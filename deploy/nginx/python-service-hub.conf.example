server {
    listen 443 ssl;
    server_name hub.internal.example;

    ssl_certificate /etc/nginx/certs/hub.crt;
    ssl_certificate_key /etc/nginx/certs/hub.key;

    access_log /var/log/nginx/python-service-hub.access.log;
    client_max_body_size 10g;

    location = /internal/v1 {
        deny all;
    }

    location ^~ /internal/v1/ {
        deny all;
    }

    location / {
        # Replace these example private networks with the actual internal callers.
        allow 10.0.0.0/8;
        allow 172.16.0.0/12;
        allow 192.168.0.0/16;
        deny all;

        proxy_pass http://127.0.0.1:8000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 3700s;
        proxy_send_timeout 3700s;
    }
}
