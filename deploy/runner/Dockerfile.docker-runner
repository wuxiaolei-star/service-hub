FROM python:3.12-slim

WORKDIR /app

COPY packages/hub-contracts /app/packages/hub-contracts
COPY packages/hub-sdk /app/packages/hub-sdk
COPY packages/hub-runner /app/packages/hub-runner
COPY deploy/runner/docker_runner_service.py /app/deploy/runner/docker_runner_service.py

RUN python -m pip install --no-cache-dir \
    "docker>=7,<8" \
    /app/packages/hub-contracts \
    /app/packages/hub-sdk \
    /app/packages/hub-runner

ENV HUB_DATA_ROOT=/data

CMD ["python", "/app/deploy/runner/docker_runner_service.py"]
